#!/usr/bin/env bash
# pre-commit.guard-ssot.sample
# Opt-in Agentic OS validation hook.
# INSTALL: cp .githooks/pre-commit.guard-ssot.sample .githooks/pre-commit && chmod +x .githooks/pre-commit
#          git config core.hooksPath .githooks
# UPDATING: the installed pre-commit is a COPY (not auto-updated). After a framework
#          update, re-run the INSTALL copy to pick up hook improvements (e.g. the
#          no-python credential floor). The floor/scanner scripts themselves force-update.
#
# NOTE: core.hooksPath makes Git use ONLY .githooks/. If you already use husky/
#       lefthook/.git/hooks, this replaces them — integrate, do not overwrite.
# Validator failures block commits. Guarded SSoT receipt checks remain advisory.

set -u

ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [[ -z "$ROOT" ]]; then
  echo "ACX pre-commit: unable to locate the Git repository root."
  exit 1
fi

cd "$ROOT" || exit 1

# Credential pre-screen (issue #225): block secrets BEFORE they enter object history
# — CI secret scanning only fires post-commit, by which point rotation (not deletion) is the
# remedy. Python path = scan_credentials.py (full detection); NO-PYTHON path =
# credential_floor.sh (narrow FP-free AKIA/PEM/ghp_ subset; no silent skip). A scanner
# that CANNOT RUN falls through to the floor instead of passing the commit unscanned
# (dev-flow-hardening AC-8: the credential floor cannot fail open silently). The floor
# trades in BOTH directions and is not a drop-in: it reads each whole staged blob where
# the scanner reads only ADDED lines, but screens 3 credential shapes where the scanner
# screens 7. Opt-in hook; --no-verify-bypassable. A deployed tree ships
# no .github/workflows, so an adopter may have no CI backstop at all.
CREDENTIAL_SCANNER=".agentcortex/tools/scan_credentials.py"
CREDENTIAL_FLOOR=".agentcortex/tools/credential_floor.sh"
# Existence is not startability: on stock Windows the WindowsApps App-Execution-Alias
# `python`/`python3` EXIST on PATH with no Python installed and exit 9009. Probe each
# candidate the way validate.sh does (same python3 -> python order) so a stub can never
# win the selection and shadow the floor below. Ref: backlog #144, which fixed this in
# both validator twins but not here.
CRED_PY=""
for _cred_py in python3 python; do
  if command -v "$_cred_py" >/dev/null 2>&1 && "$_cred_py" -c "import sys" >/dev/null 2>&1; then
    CRED_PY="$_cred_py"; break
  fi
done
unset _cred_py
cred_rc=0
floor_ran=0
if [[ -n "$CRED_PY" && -f "$CREDENTIAL_SCANNER" ]]; then
  "$CRED_PY" "$CREDENTIAL_SCANNER" --staged; cred_rc=$?
  # An execution error is NOT a clean scan -- the same policy security.yml's
  # credential-scan job already applies. The regex floor is the canonical
  # no-python control (ADR-008 / AC-S4), so consult it before giving up rather
  # than letting a scanner failure pass the commit through unscanned.
  if [[ "$cred_rc" -ne 0 && "$cred_rc" -ne 1 && -f "$CREDENTIAL_FLOOR" ]]; then
    echo "ACX pre-commit: python scanner could not run (exit $cred_rc); falling back to the no-python floor."
    bash "$CREDENTIAL_FLOOR" --staged; cred_rc=$?; floor_ran=1
    if [[ "$cred_rc" -eq 0 ]]; then
      echo "ACX pre-commit: REDUCED ASSURANCE -- the floor screens 3 credential shapes, the python scanner screens 7. A clean floor result is NOT a clean full scan; fix the scanner."
    fi
  fi
elif [[ -f "$CREDENTIAL_FLOOR" ]]; then
  bash "$CREDENTIAL_FLOOR" --staged; cred_rc=$?; floor_ran=1   # no-python narrow floor
else
  echo "ACX pre-commit: no credential pre-screen available on this host; only CI secret scanning can backstop this, if your CI runs one."
fi
if [[ "$cred_rc" -eq 1 ]]; then
  echo "ACX pre-commit: credential pattern detected in staged changes; commit blocked."
  echo "   Rotate the exposed secret, remove it from the change, then re-commit."
  exit 1
elif [[ "$cred_rc" -ne 0 ]]; then
  if [[ "$floor_ran" -eq 1 ]]; then
    echo "ACX pre-commit: credential pre-screen could not run (floor exit $cred_rc); continuing UNSCANNED. Only CI secret scanning can backstop this, if your CI runs one."
  else
    echo "ACX pre-commit: credential pre-screen could not run (exit $cred_rc) and the no-python floor was not available; continuing UNSCANNED. Only CI secret scanning can backstop this, if your CI runs one."
  fi
fi

GUARD_RECEIPT=".agentcortex/context/.guard_receipts"
GUARDED_PATHS=(
  ".agentcortex/context/current_state.md"
  "AGENTS.md"
  ".agent/config.yaml"
)

is_windows_git_shell() {
  case "$(uname -s 2>/dev/null || echo unknown)" in
    MINGW*|MSYS*|CYGWIN*) return 0 ;;
    *) return 1 ;;
  esac
}

run_validator() {
  if is_windows_git_shell && [[ -f ".agentcortex/bin/validate.ps1" ]]; then
    if command -v powershell >/dev/null 2>&1; then
      powershell -ExecutionPolicy Bypass -File ".agentcortex/bin/validate.ps1"
      return $?
    fi
    if command -v pwsh >/dev/null 2>&1; then
      pwsh -NoProfile -ExecutionPolicy Bypass -File ".agentcortex/bin/validate.ps1"
      return $?
    fi
  fi

  if [[ ! -f ".agentcortex/bin/validate.sh" ]]; then
    echo "ACX pre-commit: missing .agentcortex/bin/validate.sh."
    return 1
  fi

  bash ".agentcortex/bin/validate.sh"
}

echo "ACX pre-commit: running local validator..."
if ! run_validator; then
  echo "ACX pre-commit: validator failed; commit blocked."
  exit 1
fi
echo "ACX pre-commit: validator passed."

for path in "${GUARDED_PATHS[@]}"; do
  if git diff --cached --name-only | grep -qxF "$path"; then
    # Check for a recent receipt (written in last 60 minutes)
    if [[ ! -d "$GUARD_RECEIPT" ]] || ! find "$GUARD_RECEIPT" -name "*.json" -newer "$path" -mmin -60 | grep -q .; then
      echo "GUARD WARN: $path staged without a recent guard receipt."
      echo "   Run guard_context_write.py or use the /ship workflow to update SSoT."
      echo "   (Advisory only - commit not blocked)"
    fi
  fi
done

exit 0
